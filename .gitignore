# Data (large / not for repo)
data/raw/
data/processed/
*.csv
# small committed sample for the app's Data Explorer
!data/sample.csv

# SQLite CRUD store (created at runtime)
data/emi_records.db

# MLflow tracking store
mlruns/
mlartifacts/
mlflow.db

# Models: ignore large exports, but COMMIT the small champion pickles the
# Streamlit Cloud app loads at serving time.
models/*.pkl
models/*.joblib
!models/.gitkeep
!models/clf_champion.pkl
!models/reg_champion.pkl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Virtual environments
.venv/
venv/
env/

# Reports: keep markdown docs and result CSVs; exclude plots and the brief
!reports/*.csv
reports/*.png

# Project brief (kept local, not published)
Project Title.docx

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Secrets
.env
.streamlit/secrets.toml
